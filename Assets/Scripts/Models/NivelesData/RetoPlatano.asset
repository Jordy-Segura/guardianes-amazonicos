  _tituloNivel: "Nivel 1 \u2022 Conozco la selva"
  _siguienteEscena: 
  _pregunta: "Observa la selva. \xBFCu\xE1l de estos frutos es el pl\xE1tano?"
  _opciones:
  - Heliconia
  - Cacao
  - "Pl\xE1tano"
  _imagenesOpciones:
